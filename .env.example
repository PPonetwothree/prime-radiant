# Copy to .env and fill in. This file is read by the Node server.

# Veritas (the AI analyst) needs ONE of these keys. Without either, the news
# feed still works; only Veritas is disabled. If both are set, Groq is used.
#   Groq:   https://console.groq.com/keys
#   Gemini: https://aistudio.google.com/apikey
GROQ_API_KEY=
GEMINI_API_KEY=
# LLM_PROVIDER=groq            # force a provider when both keys are set
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-2.5-flash
# Characters of news context per Veritas request (default 8000 Groq, 40000 Gemini).
# Lower it if Groq reports "request too large".
# CONTEXT_CHARS=8000

# Story tagging with Groq (on whenever GROQ_API_KEY is set)
# TAG_WITH_LLM=off             # use keyword rules only
# TAG_MODEL=openai/gpt-oss-20b
# TAG_BATCH=40                 # stories per request
# TAG_DAILY_REQUESTS=800       # stop before Groq's 1000/day free limit

# Watchlist alerts on Telegram (optional, see README)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# PORT=5000
# REFRESH_MINUTES=10
# VERITAS_PER_MINUTE=10
# How long to keep reports in the archive, and where the database lives
# RETENTION_DAYS=180
# DATA_DIR=server/.data
# Extra origins allowed to call the API (only needed if the site is hosted separately)
# CORS_ORIGINS=http://localhost:5173

# Front end: leave unset to use the same server. Set only if the API is on another host.
# REACT_APP_API_URL=https://your-api.example.com/api
